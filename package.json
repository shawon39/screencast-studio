{
  "name": "screencast-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turns one raw screen recording into a finished video. Runs locally.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "doctor": "node src/doctor.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "clean-training": "node scripts/clean-training.ts",
    "clone": "node scripts/clone.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.73.0",
    "@remotion/bundler": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "typescript": "^7.0.2"
  }
}
